    - target: {fileID: 1263566951456282426, guid: 2c992591f77e2684b9f61934731e8e33, type: 3}
      propertyPath: '_texts.Array.data[1]'
      value: "\u042F \u0442\u0440\u043E\u043D\u0443\u0442 \u0447\u0442\u043E \u0442\u044B
        \u043F\u0440\u043E\u0448\u0435\u043B \u0438\u0433\u0440\u0443 \u043D\u0430
        \u0432\u0441\u0435 \u043A\u043E\u043D\u0446\u043E\u0432\u043A\u0438"
      objectReference: {fileID: 0}
    - target: {fileID: 1263566951456282426, guid: 2c992591f77e2684b9f61934731e8e33, type: 3}
      propertyPath: '_texts.Array.data[2]'
      value: "\u0422\u044B \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043C\u043E\u043B\u043E\u0434\u0435\u0446
        \u0447\u0442\u043E \u043F\u0440\u043E\u0448\u0435\u043B \u0435\u0451\n\u042F
        \u044D\u0442\u043E \u0446\u0435\u043D\u044E"
      objectReference: {fileID: 0}
    - target: {fileID: 1263566951456282426, guid: 2c992591f77e2684b9f61934731e8e33, type: 3}
      propertyPath: '_texts.Array.data[3]'
      value: "\u041F\u043E\u043A\u0430 \u0447\u0442\u043E \u044D\u0442\u043E \u0441\u0430\u043C\u0430\u044F
