      value: "\u041F\u0440\u0438\u0432\u0435\u0442, \u044D\u0442\u043E \u0441\u043D\u043E\u0432\u0430
        \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A"
      objectReference: {fileID: 0}
    - target: {fileID: 1263566951456282426, guid: 2c992591f77e2684b9f61934731e8e33, type: 3}
      propertyPath: '_texts.Array.data[1]'
      value: "\u041D\u0435 \u0434\u0443\u043C\u0430\u043B \u0447\u0442\u043E \u0442\u044B
        \u0437\u0430\u0431\u0435\u0440\u0435\u0448\u044C\u0441\u044F \u0442\u0430\u043A
        \u0434\u0430\u043B\u0435\u043A\u043E"
      objectReference: {fileID: 0}
    - target: {fileID: 1263566951456282426, guid: 2c992591f77e2684b9f61934731e8e33, type: 3}
      propertyPath: '_texts.Array.data[2]'
      value: "\u0422\u044B \u043F\u0440\u043E\u0448\u0435\u043B \u0446\u0435\u043B\u044B\u0445
        2 \u043A\u043E\u043D\u0446\u043E\u0432\u043A\u0438!"
      objectReference: {fileID: 0}
    - target: {fileID: 1263566951456282426, guid: 2c992591f77e2684b9f61934731e8e33, type: 3}
      propertyPath: '_texts.Array.data[3]'
      value: "\u0414\u0443\u043C\u0430\u044E \u0447\u0442\u043E \u0442\u044B \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u0435\u0448\u044C
        \u0443\u0437\u043D\u0430\u0442\u044C \u043E \"\u0421\u0435\u043A\u0440\u0435\u0442\u043D\u043E\u0439
        \u043A\u043E\u043D\u0446\u043E\u0432\u043A\u0435\""
      objectReference: {fileID: 0}
    - target: {fileID: 1263566951456282426, guid: 2c992591f77e2684b9f61934731e8e33, type: 3}
      propertyPath: '_texts.Array.data[4]'
      value: "\u0415\u0441\u043B\u0438 \u0442\u044B \u043E\u0442\u043D\u0435\u0441\u0435\u0448\u044C
        \u0442\u043E\u0440\u0442 \u0432 \u0442\u044E\u0440\u044C\u0438\u0443, \u0442\u043E
        \u0441\u043B\u0443\u0447\u0438\u0442\u0441\u044F \u0447\u0442\u043E-\u0442\u043E
        \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u0435"
      objectReference: {fileID: 0}
    - target: {fileID: 1263566951456282426, guid: 2c992591f77e2684b9f61934731e8e33, type: 3}
