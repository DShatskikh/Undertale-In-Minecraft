      propertyPath: _replicas.Array.data[0].Text
      value: "\u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044B \u043D\u0435 \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u0435\u0448\u044C
